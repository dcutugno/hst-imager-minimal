{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hst Imager DOpus",
  "version": "0.1.0",
  "identifier": "com.hstimager.dopus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hst Imager DOpus",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/hst-imager-go"]
  }
}
